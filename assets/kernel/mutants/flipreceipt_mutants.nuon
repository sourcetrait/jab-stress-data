[
  [name,               program,       expect,                                                         edits];
  [ordinal_unraised,   test/framecap, "the present ordinal rises by one a presented flip and a print", [
      [file,                   find,                                                                                                     put];
      ["kernel/src/display.S", "    la t0, present_ordinal      # the flush answered OK: one more present\n    ld t1, 0(t0)\n    addi t1, t1, 1\n    sd t1, 0(t0)\n", ""]
    ]],
  [list_merged_answer, test/framecap, "the list's flush answered OK counts its present",              [
      [file,                   find,                                                                                put];
      ["kernel/src/display.S", "    lwu t1, VIRTIO_GPU_HDR_TYPE(t2)\n    li t2, VIRTIO_GPU_RESP_OK_NODATA\n    bne t1, t2, 18f\n", "    bnez a0, 18f\n"]
    ]],
  [tick_after_flip,    test/framecap, "a presented flip's stamp at or past its tick",                 [
      [file,                   find,                                                         put];
      ["kernel/src/display.S", "    sd a2, 96(sp)               # the eligibility tick it read\n", ""],
      ["kernel/src/display.S", "    call frame_flipped\n    li a0, 0\n    j 1f\n2:\n",               "    call frame_flipped\n    call frame_ready\n    sd a2, 96(sp)\n    li a0, 0\n    j 1f\n2:\n"]
    ]],
  [failed_stamp_kept,  test/framecap, "a refused-before-the-check flip observes no decision",         [
      [file,                   find,                                                                  put];
      ["kernel/src/display.S", "    sd zero, 88(sp)             # failed already: no decision observed\n", ""]
    ]]
]
