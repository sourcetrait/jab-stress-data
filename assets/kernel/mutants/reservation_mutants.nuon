[
  {name: "reserve_again_allowed", program: "test/reservations", expect: "three, line 4:", edits: [{file: "kernel/src/owners.S", find: "    bnez t0, 8f\n    li a0, JAB_OWNER_NONE", put: "    nop\n    li a0, JAB_OWNER_NONE"}]},
  {name: "reserve_short_allowed", program: "test/reservations", expect: "three, line 3:", edits: [{file: "kernel/src/owners.S", find: "    bltu t0, s0, 8f                         # fewer than the count: nothing reserved", put: "    nop"}]},
  {name: "reserve_busy_allowed", program: "test/reservations", expect: "three, line 3:", edits: [{file: "kernel/src/owners.S", find: "    li s2, JAB_RESERVE_BUSY\n    bnez a0, 8f                             # a worker running", put: "    li s2, JAB_RESERVE_BUSY\n    nop"}]},
  {name: "floor_unrecorded", program: "test/reservations", expect: "three, line 6:", edits: [{file: "kernel/src/owners.S", find: "    la t0, owners_floor\n    sd s0, 0(t0)", put: "    la t0, owners_floor\n    nop"}]},
  {name: "knob_ignored", program: "test/reservations", expect: "spent, line 7:", edits: [{file: "kernel/src/owners.S", find: "    la t1, owners_next\n    sd t0, 0(t1)                            # jab.claimids=<n>: n ids left, the limit proved without 2^63 claims", put: "    la t1, owners_next\n    nop"}]},
  {name: "debug_reserved_dropped", program: "test/reservations", expect: "three: each change of ownership on the debug channel", edits: [{file: "kernel/src/owners.S", find: "    la a0, msg_reserved\n    call debug_puts", put: ""}]},
  {name: "claim_unreserved_allowed", program: "test/reservations", expect: "three, line 3:", edits: [{file: "kernel/src/owners.S", find: "    beqz t0, 8f\n    li a0, JAB_OWNER_RESERVED\n    call owned_mask", put: "    nop\n    li a0, JAB_OWNER_RESERVED\n    call owned_mask"}]},
  {name: "claim_empty_allowed", program: "test/reservations", expect: "three, line 6:", edits: [{file: "kernel/src/owners.S", find: "    beqz s0, 8f                             # an empty mask", put: "    nop"}]},
  {name: "claim_outside_allowed", program: "test/reservations", expect: "three, line 6:", edits: [{file: "kernel/src/owners.S", find: "    bnez t0, 8f                             # a hart outside the grant: hart 0, offline, failed, or claimed", put: "    nop"}]},
  {name: "claim_busy_allowed", program: "test/reservations", expect: "three, line 6:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_BUSY\n    bnez a0, 8f                             # a worker on a hart of it", put: "    li s3, JAB_CLAIM_BUSY\n    nop"}]},
  {name: "claim_floor_ignored", program: "test/reservations", expect: "three, line 6:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_FLOOR\n    bltu t0, t1, 8f", put: "    li s3, JAB_CLAIM_FLOOR\n    nop"}]},
  {name: "claim_spent_ignored", program: "test/reservations", expect: "spent, line 10:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_SPENT\n    bgeu s2, t1, 8f                         # the run's ids spent: nothing moved, the counter as it stands", put: "    li s3, JAB_CLAIM_SPENT\n    nop"}]},
  {name: "claim_spent_boundary", program: "test/reservations", expect: "spent, line 10:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_SPENT\n    bgeu s2, t1, 8f                         # the run's ids spent: nothing moved, the counter as it stands", put: "    li s3, JAB_CLAIM_SPENT\n    bgtu s2, t1, 8f"}]},
  {name: "claim_ids_reused", program: "test/reservations", expect: "three, line 10:", edits: [{file: "kernel/src/owners.S", find: "    addi t1, s2, 1\n    sd t1, 0(t0)", put: "    mv t1, s2\n    sd t1, 0(t0)"}]},
  {name: "claim_sets_no_owner", program: "test/reservations", expect: "three, line 7:", edits: [{file: "kernel/src/owners.S", find: "    mv a0, s0\n    mv a1, s2\n    call set_owner", put: "    mv a0, s0\n    mv a1, s2"}]},
  {name: "claim_ids_short", program: "test/reservations", expect: "spent, line 7:", edits: [{file: "kernel/src/include/hart.inc", find: ".set CLAIM_IDS, 0x7ffffffffffffffe", put: ".set CLAIM_IDS, 0x7ffffffffffffffd"}]},
  {name: "release_unknown_low", program: "test/reservations", expect: "three, line 11:", edits: [{file: "kernel/src/owners.S", find: "    bltu s0, t0, 8f                         # none and the reservation are no claim's", put: "    nop"}]},
  {name: "release_unknown_empty", program: "test/reservations", expect: "three, line 9:", edits: [{file: "kernel/src/owners.S", find: "    beqz s1, 8f                             # no hart holds it", put: "    nop"}]},
  {name: "release_busy_allowed", program: "test/reservations", expect: "three, line 8:", edits: [{file: "kernel/src/owners.S", find: "    li s2, JAB_RELEASE_BUSY\n    bnez a0, 8f", put: "    li s2, JAB_RELEASE_BUSY\n    nop"}]},
  {name: "release_moves_nothing", program: "test/reservations", expect: "three, line 9:", edits: [{file: "kernel/src/owners.S", find: "    mv a0, s1\n    li a1, JAB_OWNER_RESERVED\n    call set_owner\n.ifdef DEBUG\n    la a0, msg_released", put: "    mv a0, s1\n    li a1, JAB_OWNER_RESERVED\n.ifdef DEBUG\n    la a0, msg_released"}]},
  {name: "owned_counts_all", program: "test/reservations", expect: "three, line 4:", edits: [{file: "kernel/src/owners.S", find: "    ld t3, HART_OWNER(t2)\n    bne t3, t5, 2f", put: "    ld t3, HART_OWNER(t2)\n    nop"}]},
  {name: "working_ignores", program: "test/reservations", expect: "three, line 3:", edits: [{file: "kernel/src/owners.S", find: "    ld t3, HART_WORK(t2)\n    beqz t3, 2f", put: "    li t3, 0\n    beqz t3, 2f"}]},
  {name: "start_owner_unchecked", program: "test/reservations", expect: "three, line 5:", edits: [{file: "kernel/src/workers.S", find: "    ld t1, HART_OWNER(s5)\n    bne t0, t1, 9f", put: "    ld t1, HART_OWNER(s5)\n    nop"}]},
  {name: "start_owner_always", program: "test/reservations", expect: "three, line 2:", edits: [{file: "kernel/src/workers.S", find: "    beqz t0, 10f                            # no reservation: the owner unread, whatever a5 holds", put: "    nop"}]},
  {name: "start_owner_after_busy", program: "test/reservations", expect: "three, line 8:", edits: [{file: "kernel/src/workers.S", find: "    la t0, owners_reserved\n    ld t0, 0(t0)\n    beqz t0, 10f                            # no reservation: the owner unread, whatever a5 holds\n    li a0, JAB_START_OWNER\n    ld t0, 120(sp)                          # the owner the worker would run under\n    ld t1, HART_OWNER(s5)\n    bne t0, t1, 9f\n10:\n", put: ""}, {file: "kernel/src/workers.S", find: "    fence r, rw                             # its last worker's exit, released before its idle, before this start's stores", put: "    la t0, owners_reserved\n    ld t0, 0(t0)\n    beqz t0, 10f\n    li a0, JAB_START_OWNER\n    ld t0, 120(sp)\n    ld t1, HART_OWNER(s5)\n    bne t0, t1, 9f\n10:\n    fence r, rw"}]},
  {name: "macro_clears_a5", program: "test/reservations", expect: "three, line 2:", edits: [{file: "sdk/src/jab.inc", find: ".ifnb \\owner\n    mv a5, \\owner\n.endif", put: ".ifb \\owner\n    li a5, JAB_OWNER_NONE\n.else\n    mv a5, \\owner\n.endif"}]},
  {name: "macro_owner_last", program: "test/reservations", expect: "three, line 8:", edits: [{file: "sdk/src/jab.inc", find: ".ifnb \\owner\n    mv a5, \\owner\n.endif\n    mv a4, \\size\n    mv a3, \\stack\n    mv a2, \\argument\n    la a1, \\entry\n    mv a0, \\hart", put: "    mv a4, \\size\n    mv a3, \\stack\n    mv a2, \\argument\n    la a1, \\entry\n    mv a0, \\hart\n.ifnb \\owner\n    mv a5, \\owner\n.endif"}]},
  {name: "worker_may_reserve", program: "test/reservations", expect: "three, line 12:", edits: [{file: "kernel/src/trap.S", find: "    li t0, JAB_SYS_WORKER_EXIT\n    beq a7, t0, call_table", put: "    li t0, JAB_SYS_WORKER_EXIT\n    beq a7, t0, call_table\n    li t0, JAB_SYS_HARTS_RESERVE\n    beq a7, t0, call_table"}]}
]
