[
  {name: "claim_busy_allowed", program: "test/feature", expect: "three, line 7:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_BUSY\n    bnez a0, 8f                             # a worker on a hart of it", put: "    li s3, JAB_CLAIM_BUSY\n    nop"}]},
  {name: "claim_floor_ignored", program: "test/feature", expect: "three, line 4:", edits: [{file: "kernel/src/owners.S", find: "    li s3, JAB_CLAIM_FLOOR\n    bltu t0, t1, 8f", put: "    li s3, JAB_CLAIM_FLOOR\n    nop"}]},
  {name: "grant_discovered", program: "test/feature", expect: "sparse, line 2:", edits: [{file: "kernel/src/owners.S", find: "    call harts_masks\n    andi t4, a0, -2                         # the online secondaries", put: "    la t4, harts_discovered\n    ld t4, 0(t4)\n    andi t4, t4, -2"}]},
  {name: "release_busy_allowed", program: "test/feature", expect: "four, line 8:", edits: [{file: "kernel/src/owners.S", find: "    li s2, JAB_RELEASE_BUSY\n    bnez a0, 8f", put: "    li s2, JAB_RELEASE_BUSY\n    nop"}]},
  {name: "start_owner_unchecked", program: "test/feature", expect: "four, line 12:", edits: [{file: "kernel/src/workers.S", find: "    ld t1, HART_OWNER(s5)\n    bne t0, t1, 9f", put: "    ld t1, HART_OWNER(s5)\n    nop"}]},
  {name: "macro_sixth_unloaded", program: "test/feature", expect: "three, line 5:", edits: [{file: "sdk/src/jab.inc", find: ".ifnb \\owner\n    mv a5, \\owner\n.endif", put: ".ifnb \\owner\n.endif"}]},
  {name: "feature_constant_miswritten", program: "test/feature", expect: "three, line 3:", edits: [{file: "sdk/nu/jab.nu", find: "$\".set JAB_FEATURE_($f.name | str uppercase)_($r.role | str uppercase), ($r.harts)\"", put: "$\".set JAB_FEATURE_($f.name | str uppercase)_($r.role | str uppercase), ($r.harts + 1)\""}]},
  {name: "reserved_constant_miswritten", program: "test/feature", expect: "three, line 2:", edits: [{file: "sdk/nu/jab.nu", find: "$\".set JAB_RESERVED_($r.role | str uppercase), ($r.harts)\"", put: "$\".set JAB_RESERVED_($r.role | str uppercase), ($r.harts + 1)\""}]},
  {name: "stop_before_join", program: "test/feature", expect: "four, line 16:", edits: [{file: "test/feature/src/main.S", find: "    call release_hold                       # the boundary: the band let go, the frame joined\n    call frame_join\n    jab.sys.worker.stop s1                  # then the hart's worker, waiting in its mailbox\n    mv s5, a0\n    mv s6, a1\n    la t0, hold_word\n    lw s7, 0(t0)\n    la s11, line\n    la a1, word_transition_stop\n    mv a0, s5\n    call field\n    la a1, word_interrupted\n    mv a0, s6\n    call field\n    la a1, word_hold\n    mv a0, s7\n    call field\n    call say\n    bnez s6, stop_run                       # interrupted: no join after it\n", put: "    jab.sys.worker.stop s1                  # then the hart's worker, waiting in its mailbox\n    mv s5, a0\n    mv s6, a1\n    la t0, hold_word\n    lw s7, 0(t0)\n    la s11, line\n    la a1, word_transition_stop\n    mv a0, s5\n    call field\n    la a1, word_interrupted\n    mv a0, s6\n    call field\n    la a1, word_hold\n    mv a0, s7\n    call field\n    call say\n    bnez s6, stop_run                       # interrupted: no join after it\n    call release_hold                       # the boundary: the band let go, the frame joined\n    call frame_join\n"}]},
  {name: "forced_expiry", program: "test/feature", expect: "four: the hold expired, the stop interrupted 8 and no record holds the held frame", class: "unexercised", edits: [{file: "test/feature/src/main.S", find: ".set HOLD_TICKS, (2 * JAB_TIME_HZ)", put: ".set HOLD_TICKS, 0"}, {file: "test/feature/src/main.S", find: "    sc.w t4, t5, (t0)\n    bnez t4, 21b\n", put: "    sc.w t4, t5, (t0)\n    bnez t4, 21b\n    li a0, 1\n    li a7, JAB_SYS_WORKER_WAKE\n    ecall\n4:\n    pause\n    j 4b\n"}, {file: "test/feature/src/main.S", find: "    lw t0, 0(t2)\n    li t1, HOLD_IDLE\n    bne t0, t1, 2f\n    mv a0, t2\n    mv a1, t1\n", put: "    lw t0, 0(t2)\n    li t1, HOLD_EXPIRED\n    beq t0, t1, 2f\n    mv a0, t2\n    mv a1, t0\n"}, {file: "test/feature/src/main.S", find: "    call release_hold                       # the boundary: the band let go, the frame joined\n    call frame_join\n    jab.sys.worker.stop s1                  # then the hart's worker, waiting in its mailbox\n    mv s5, a0\n    mv s6, a1\n    la t0, hold_word\n    lw s7, 0(t0)\n    la s11, line\n    la a1, word_transition_stop\n    mv a0, s5\n    call field\n    la a1, word_interrupted\n    mv a0, s6\n    call field\n    la a1, word_hold\n    mv a0, s7\n    call field\n    call say\n    bnez s6, stop_run                       # interrupted: no join after it\n", put: "    jab.sys.worker.stop s1                  # then the hart's worker, waiting in its mailbox\n    mv s5, a0\n    mv s6, a1\n    la t0, hold_word\n    lw s7, 0(t0)\n    la s11, line\n    la a1, word_transition_stop\n    mv a0, s5\n    call field\n    la a1, word_interrupted\n    mv a0, s6\n    call field\n    la a1, word_hold\n    mv a0, s7\n    call field\n    call say\n    bnez s6, stop_run                       # interrupted: no join after it\n    call release_hold                       # the boundary: the band let go, the frame joined\n    call frame_join\n"}]}
]
