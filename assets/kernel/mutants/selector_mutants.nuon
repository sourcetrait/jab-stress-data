   ["kernel/timing/select.nu", "evidence: (if (admitted $readings.controls \"timing\" $runs) { \"admissible\" } else { \"instrumented-only\" })", "evidence: \"admissible\""]
  ]],
 [timing_filter_removed,       "TIMING on refused",            [
   [file,                      find,                                                             put];
   ["kernel/timing/select.nu", "kernel: $kernel, order: $order, timing: false, probed: false }", "kernel: $kernel, order: $order, probed: false }"]
  ]],
 [probed_filter_removed,       "probed walk refused",          [
