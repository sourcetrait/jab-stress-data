[
 [name,                        expect,                         edits];
 [floor_removed,               "regression floor",             [
   [file,                      find,                                               put];
   ["kernel/timing/select.nu", "and $c.d > $c.n and $c.d > $REGRESSION_FLOOR_MS)", "and $c.d > $c.n)"]
  ]],
 [noise_in_regression_removed, "regression within noise",      [
   [file,                      find,                                            put];
   ["kernel/timing/select.nu", "regressing: ($c.d != null and $c.d > $c.n and", "regressing: ($c.d != null and"]
  ]],
 [regression_removed,          regression,                     [
   [file,                      find,                                                                                      put];
   ["kernel/timing/select.nu", "leg: $leg, regressing: ($c.d != null and $c.d > $c.n and $c.d > $REGRESSION_FLOOR_MS) }", "leg: $leg, regressing: false }"]
  ]],
 [missing_removed,             "no fps comparison",            [
   [file,                      find,                                   put];
   ["kernel/timing/select.nu", "let missing = ($TARGETS | where {|t|", "let missing = ([] | where {|t|"]
  ]],
 [display_worse_removed,       "display worse",                [
   [file,                      find,                                                                                           put];
   ["kernel/timing/select.nu", "state: \"admissible\", why: \"\", worse: ($c.d != null and $c.compared > ($c.base + $c.n)) }", "state: \"admissible\", why: \"\", worse: false }"]
  ]],
 [guest_presentation_removed,  presentation,                   [
   [file,                      find,                                                                    put];
   ["kernel/timing/select.nu", "leg: $leg, worse: ($c.d != null and $c.compared > ($c.base + $c.n)) }", "leg: $leg, worse: false }"]
  ]],
 [noise_gate_removed,          "noise gate",                   [
   [file,                      find,                                          put];
   ["kernel/timing/select.nu", "{ passed: ($over | is-empty), over: $over }", "{ passed: true, over: $over }"]
  ]],
 [eps_removed,                 "eps short",                    [
   [file,                      find,                                                          put];
   ["kernel/timing/select.nu", "let calibrated = ($readings.calibration.state != \"short\")", "let calibrated = true"]
  ]],
 [checks_removed,              checks,                         [
   [file,                      find,                                                    put];
   ["kernel/timing/select.nu", "| where {|k| ($readings.checks | get -o $k) != true }", "| where {|k| false }"]
  ]],
 [k_removed,                   "K in fps",                     [
   [file,                      find,                                                       put];
   ["kernel/timing/select.nu", "where {|r| $r.kernel == \"P2\" and $r.k_violations > 0 }", "where {|r| false }"]
  ]],
 [scope_kernel_removed,        "control scope",                [
   [file,                      find,                                                     put];
   ["kernel/timing/select.nu", "const SCOPE = [host target kernel order backend build]", "const SCOPE = [host target order backend build]"]
  ]],
