[
  [name,                     kind,    cases,                     expect,                              edits];
  [drawing_from_wait,        reader,  [

    ],                  "PREPARE's drawing",                 [
      [file,                     find,                                                             put];
      ["kernel/walk/cadence.nu", "work: (spread ($frames | each {|f| $f.work_end - $f.start })),", "work: (spread ($frames | each {|f| $f.work_end - $f.wait_end })),"]
    ]],
  [replay_raw,               reader,  [

    ],                  replay-of,                           [
      [file,                     find,                                                                       put];
      ["kernel/walk/cadence.nu", "$head ++ ($stream.frames | each {|f| do $word $f.dt 4 } | bytes collect)", "$head ++ ($stream.frames | each {|f| do $word $f.raw 4 } | bytes collect)"]
    ]],
  [untimed_as_timed,         reader,  [

    ],                  "TIMING off",                        [
      [file,                     find,                                                                                   put];
      ["kernel/walk/cadence.nu", "(if $fl.timing { phase-faults $frames $fl.prepare } else { untimed-faults $frames })", "(phase-faults $frames $fl.prepare)"]
    ]],
  [binding_uncompared,       reader,  [

    ],                  "a nonce other than the identity's", [
      [file,                     find,                                                                                     put];
      ["kernel/walk/cadence.nu", "let binding = (if $wanted == null or $wanted == 0 or $wanted != $stream.header.nonce {", "let binding = (if false {"]
    ]],
  [receipts_skipped,         reader,  [

    ],                  "presents at 2, 4, 5",               [
      [file,                     find,                                                                                                                                                         put];
      ["kernel/walk/cadence.nu", "let receipts = (if ($stream.frames | is-empty) { [] } else { receipt-faults $stream.frames $stream.header.origin (flags-of $stream.header.flags).timing })", "let receipts = []"]
    ]],
  [receipt_flip_removed,     reader,  [

    ],                  "no flip, a status of 0",            [
      [file,                     find,                                                                                                                                                                     put];
      ["kernel/walk/cadence.nu", "        if $f.issued == 0 { $f.status != $NO_STATUS or $f.s != 0 or $f.t != 0 } else if $f.status in [0 1] { $f.s == 0 or $f.t == 0 } else { $f.status == $NO_STATUS }", "        false"]
    ]],
  [present_sequence_removed, reader,  [

    ],                  "presents at 2, 4, 5",               [
      [file,                     find,                                                    put];
      ["kernel/walk/cadence.nu", "let violations = (jab ordinal-violations 1 $presents)", "let violations = []"]
    ]],
  [acceptance_removed,       reader,  [

    ],                  "an acceptance before its tick",     [
      [file,                     find,                                         put];
      ["kernel/walk/cadence.nu", "$f.s < $f.t or $f.s < $low or $f.s > $high", "false"]
    ]],
  [wait_while_ready,         program, [
      prepare_off
    ], "back to back",                      [
      [file,                      find,                                                              put];
      ["example/walk/src/main.S", "    jab.sys.display.await
    li t0, 1
    sb t0, F_WAITED(s5)
", "    jab.sys.display.ready
    bnez a0, 9f
    jab.sys.display.await
9:
    li t0, 1
    sb t0, F_WAITED(s5)
"]
    ]],
  [unflipped_ordinal_zero,   program, [
      await_off
    ],   "the present sequence: backward",    [
      [file,                      find,                                                                 put];
      ["example/walk/src/main.S", "    la t0, last_ordinal
    ld t0, 0(t0)
    sw t0, F_ORDINAL(s5)
", "    sw zero, F_ORDINAL(s5)
"]
    ]]
]