[
  {
    name: increment_removed
    program: test/sound
    expect: "sound: the late service alone found its queue empty"
    edits: [
      [file, find, put];
      ["kernel/src/sound.S", "    addi t1, t1, 1                          # every period back: the queue empty after the drain", ""]
    ]
  }
  {
    name: check_at_entry
    program: test/sound
    expect: "sound: the late service alone found its queue empty"
    edits: [
      [file, find, put];
      ["kernel/src/sound.S", "    call sound_drain\n.ifdef DEBUG\n    call sound_count_empty\n.endif\n", "    call sound_drain\n"]
      ["kernel/src/sound.S", "    call sound_late_spin\n", "    call sound_count_empty\n    call sound_late_spin\n"]
    ]
  }
  {
    name: oneshot_unspent
    program: test/sound
    expect: "the late run's exit status"
    edits: [
      [file, find, put];
      ["kernel/src/sound.S", "    sd zero, 0(t0)                          # one shot: spent before it runs", ""]
    ]
  }
]
