[
  {
    name: forbidden_emptied
    program: test/owners
    expect: "owners: forbidden_call"
    edits: [
      [file, find, put];
      ["test/owners/test/test.nu", "const forbidden_files = [display keyboard pad sound synth smf soundfont block romfs serial random pci timer]", "const forbidden_files = []"]
    ]
  }
  {
    name: indirect_unchecked
    program: test/owners
    expect: "owners: indirect_call"
    edits: [
      [file, find, put];
      ["test/owners/test/test.nu", "                        $violations = ($violations | append { kind: indirect, function: $f.name, symbol: \"\", offset: ($ins.addr - $f.start), detail: $\"($ins.op) ($ins.args), no listed dispatch site\", path: (path-to $funcs $seen $i) })", ""]
    ]
  }
  {
    name: data_unscanned
    program: test/owners
    expect: "owners: driver_data"
    edits: [
      [file, find, put];
      ["test/owners/test/test.nu", "            if $p == null or $p.section not-in $data_sections or $p.file not-in $forbidden_files { continue }", "            continue"]
    ]
  }
  {
    name: allowlist_widened
    program: test/owners
    expect: "owners: second_sound_base"
    edits: [
      [file, find, put];
      ["test/owners/test/test.nu", "            if $listed and $key not-in $used {", "            if $listed {"]
    ]
  }
  {
    name: secondary_claims
    program: test/owners
    expect: "owners: no hart but 0 claimed a device identity"
    edits: [
      [file, find, put];
      ["kernel/src/workers.S", "    sext.w s1, s1                           # the value's 32 bits, as lw reads the word", "    sext.w s1, s1                           # the value's 32 bits, as lw reads the word\n    li t0, IMSIC_EIE0\n    csrw CSR_SISELECT, t0\n    li t0, (1 << 63)\n    csrs CSR_SIREG, t0"]
      ["kernel/src/workers.S", "    sw t0, 0(a0)", "    sw t0, 0(a0)\n    li t0, 63\n    sw t0, 0(a0)"]
    ]
  }
  {
    name: secondary_enables
    program: test/owners
    expect: "owners: no secondary's file enabled a device identity"
    edits: [
      [file, find, put];
      ["kernel/src/aia.S", "    li t1, (1 << AIA_WAKE)", "    li t1, ((1 << AIA_WAKE) | (1 << 63))"]
    ]
  }
]
