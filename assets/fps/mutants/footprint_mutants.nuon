[
  [name,                   program,                 expect,                                                                       edits];
  [sign_dropped,           game/fps/test/footprint, "case 0, an ordinary floor's: the guest answered",                            [
      [file,                      find,                                                                                      put];
      ["game/fps/src/render.inc", "    sub \\s1, \\uzb, \\dst             # the derivative of u/z less u's share of 1/z's
", "    add \\s1, \\uzb, \\dst             # the derivative of u/z less u's share of 1/z's
"]
    ]],
  [shift_off_by_one,       game/fps/test/footprint, "case 0, an ordinary floor's: the guest answered",                            [
      [file,                      find,                                                                                                                                                                                                                      put];
      ["game/fps/src/render.inc", "    srli \\dst, \\dst, DEPTH_BITS
    slli \\s2, \\s1, (64 - DEPTH_BITS)
    or \\dst, \\dst, \\s2              # coord izb shifted to u/z's 48.16, its low word
    srai \\s1, \\s1, DEPTH_BITS       # its high word
", "    srli \\dst, \\dst, (DEPTH_BITS - 1)
    slli \\s2, \\s1, (64 - DEPTH_BITS + 1)
    or \\dst, \\dst, \\s2              # coord izb shifted to u/z's 48.16, its low word
    srai \\s1, \\s1, (DEPTH_BITS - 1) # its high word
"]
    ]],
  [wide_check_removed,     game/fps/test/footprint, "case 2, the first product past 64 bits once shifted: the guest answered",    [
      [file,                      find,                                                                  put];
      ["game/fps/src/render.inc", "    bne \\s1, \\s2, \\saturate         # past 64 bits once shifted
", ""]
    ]],
  [narrowed_before_shift,  game/fps/test/footprint, "case 1, both products past 64 bits, each shift fitting: the guest answered", [
      [file,                      find,                                                                                                                                                                                                                                                                                                                                                                              put];
      ["game/fps/src/render.inc", "    mul \\dst, \\coord, \\izb
    mulh \\s1, \\coord, \\izb
    srli \\dst, \\dst, DEPTH_BITS
    slli \\s2, \\s1, (64 - DEPTH_BITS)
    or \\dst, \\dst, \\s2              # coord izb shifted to u/z's 48.16, its low word
    srai \\s1, \\s1, DEPTH_BITS       # its high word
    srai \\s2, \\dst, 63
    bne \\s1, \\s2, \\saturate         # past 64 bits once shifted
", "    mul \\dst, \\coord, \\izb
    mulh \\s1, \\coord, \\izb
    srai \\s2, \\dst, 63
    bne \\s1, \\s2, \\saturate
    srai \\dst, \\dst, DEPTH_BITS
"]
    ]],
  [second_check_removed,   game/fps/test/footprint, "case 3, the second product past 64 bits once shifted: the guest answered",   [
      [file,                      find,                                                                               put];
      ["game/fps/src/render.inc", "    srai \\s1, \\s1, 16
    srai \\s2, \\dst, 63
    bne \\s1, \\s2, \\saturate
", "    srai \\s1, \\s1, 16
"]
    ]],
  [overflow_check_removed, game/fps/test/footprint, "case 4, the subtraction overflowing: the guest answered",                    [
      [file,                      find,                                                                  put];
      ["game/fps/src/render.inc", "    bltz \\s2, \\saturate             # the subtraction overflowed
", ""]
    ]],
  [absolute_check_removed, game/fps/test/footprint, "case 5, the most negative value: the guest answered",                        [
      [file,                      find,                                                                               put];
      ["game/fps/src/render.inc", "    bltz \\dst, \\saturate            # the most negative value has no absolute
", ""]
    ]],
  [absolute_dropped,       game/fps/test/footprint, "case 6, a negative derivative: the guest answered",                          [
      [file,                      find,                                                        put];
      ["game/fps/src/render.inc", "    bgez \\dst, .Lrow_derivative\\@
    neg \\dst, \\dst
", "    bgez \\dst, .Lrow_derivative\\@
"]
    ]]
]