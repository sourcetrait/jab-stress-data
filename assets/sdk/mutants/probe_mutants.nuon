  {name: ordinal_repeat_as_skip, program: test/probe, expect: "ordinals_repeat:", edits: [[file, find, put]; ["sdk/nu/jab.nu", "} else if $got == $last { \"repeat\" } else { \"skip\" })", "} else { \"skip\" })"]]},
