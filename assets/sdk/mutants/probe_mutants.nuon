[
  {name: "return_as_is", program: "test/probe", expect: "function_end:", edits: [{file: "sdk/nu/jab.nu", find: "let functions = (if $table.state == \"read\" { sdl-functions-at $table ($f.address - 1) } else { [] })", put: "let functions = (if $table.state == \"read\" { sdl-functions-at $table $f.address } else { [] })"}]},
  {name: "nearest_below", program: "test/probe", expect: "gap:", edits: [{file: "sdk/nu/jab.nu", find: "    while $at >= 0 and ($reach | get $at) > $address {", put: "    if $at >= 0 { $found = [($names | get $at)] }\n    while false {"}]},
  {name: "identity_dropped", program: "test/probe", expect: "changed:", edits: [{file: "sdk/nu/jab.nu", find: "    if $now.inode != $object.inode or ($now.size | into int) != $object.size or ($now.modified | into int) != $object.mtime {", put: "    if false {"}]},
  {name: "deleted_dropped", program: "test/probe", expect: "deleted:", edits: [{file: "sdk/nu/jab.nu", find: "    if $object.index == 0 and ($object.path | str ends-with \" (deleted)\") { return (sdl-unread \"deleted\" \"\") }", put: "    if false { return (sdl-unread \"deleted\" \"\") }"}]},
  {name: "anchor_dropped", program: "test/probe", expect: "anchor_console:", edits: [{file: "sdk/nu/jab.nu", find: "    if not ($caller.functions | any {|n| $n | str starts-with \"sdl2_\" }) { return { kind: \"refused\", class: 5, fault: \"anchor\", at: $caller } }", put: "    if false { return { kind: \"refused\", class: 5, fault: \"anchor\", at: $caller } }"}]},
  {name: "unresolved_console", program: "test/probe", expect: "exe_unresolved:", edits: [{file: "sdk/nu/jab.nu", find: "    { kind: \"refused\", class: 6, fault: \"unanswered\", at: $second }", put: "    { kind: \"console\", class: 0, fault: \"\", at: null }"}]},
  {name: "switch_upload", program: "test/probe", expect: "switch:", edits: [{file: "sdk/nu/jab.nu", find: "    if $switch and (not $update) { return { kind: \"switch\", class: 0, fault: \"\", at: null } }", put: "    if $switch and (not $update) { return { kind: \"upload\", class: 0, fault: \"\", at: null } }"}]},
  {name: "second_frame_dropped", program: "test/probe", expect: "redraw:", edits: [{file: "sdk/nu/jab.nu", find: "    if (sdl-device $second $device_in $modules) { return { kind: \"refused\", class: 5, fault: \"device\", at: $second } }", put: "    if ($frames | skip 1 | any {|f| sdl-device $f $device_in $modules }) { return { kind: \"upload\", class: 0, fault: \"\", at: null } }"}]},
  {name: "cut_short_console", program: "test/probe", expect: "cut_short:", edits: [{file: "sdk/nu/jab.nu", find: "        return { kind: \"refused\", class: 6, fault: \"cut_short\", at: $second }", put: "        return { kind: \"console\", class: 0, fault: \"\", at: null }"}]},
  {name: "module_rule_dropped", program: "test/probe", expect: "module_flip:", edits: [{file: "sdk/nu/jab.nu", find: "    let device_in = (if ($modules | is-empty) { \"executable\" } else { \"module\" })", put: "    let device_in = \"executable\""}]},
  {name: "exception_dropped", program: "test/probe", expect: "module_exception:", edits: [{file: "sdk/nu/jab.nu", find: "    if $second.object == 0 and $device_in == \"module\" and $executable != null and $executable.state == \"read\" and $executable.console {", put: "    if false {"}]},
  {name: "exception_unconditioned", program: "test/probe", expect: "exe_unresolved:", edits: [{file: "sdk/nu/jab.nu", find: "    if $second.object == 0 and $device_in == \"module\" and $executable != null and $executable.state == \"read\" and $executable.console {", put: "    if $second.object == 0 {"}]},
  {name: "absent_console", program: "test/probe", expect: "absent:", edits: [{file: "sdk/nu/jab.nu", find: "    if $second == null { return { kind: \"refused\", class: 6, fault: \"absent\", at: $caller } }", put: "    if $second == null { return { kind: \"console\", class: 0, fault: \"\", at: null } }"}]},
  {name: "dynsym_dropped", program: "test/probe", expect: "module_dynsym:", edits: [{file: "sdk/nu/jab.nu", find: "    let run = (if $dynamic { ^nm -P -t x --defined-only -D $object.path | complete } else { $full })", put: "    let run = $full"}]},
  {name: "names_whole", program: "test/probe", expect: "cold:", edits: [{file: "sdk/nu/jab.nu", find: "        | str replace --regex '^([^.]+)\\..*$' '$1' name\n", put: ""}]},
  {name: "twice_accepted", program: "test/probe", expect: "index_twice:", edits: [{file: "sdk/nu/jab.nu", find: "    if not ($twice | is-empty) { error make {msg: (sdl-refusal [{ fault: \"the object table gives an index twice\"", put: "    if false { error make {msg: (sdl-refusal [{ fault: \"the object table gives an index twice\""}]},
  {name: "unmodelled_counted", program: "test/probe", expect: "unmodelled:", edits: [{file: "sdk/nu/jab.nu", find: "    if (not $update) or $switch { return { kind: \"refused\", class: 5, fault: \"front_end\", at: $caller } }", put: "    if (not $update) or $switch { return { kind: \"console\", class: 0, fault: \"\", at: null } }"}]},
  {name: "skip_two", program: "test/probe", expect: "shim_one:", edits: [{file: "sdk/nu/jab.nu", find: "            let shim = ($frames | take while {|f| $f.object == 1 } | length)", put: "            let shim = 2"}]},
  {name: "skip_one", program: "test/probe", expect: "shim_two:", edits: [{file: "sdk/nu/jab.nu", find: "            let shim = ($frames | take while {|f| $f.object == 1 } | length)", put: "            let shim = 1"}]},
  {name: "shim_fbase", program: "test/probe", expect: "harness:", edits: [{file: "shim/crates/sdl/src/lib.rs", find: "        let link = (address as usize).wrapping_sub(unsafe { (*map).l_addr });", put: "        let mut info = DlInfo { dli_fname: std::ptr::null(), dli_fbase: std::ptr::null_mut(), dli_sname: std::ptr::null(), dli_saddr: std::ptr::null_mut() };\n        let mut extra: *mut c_void = std::ptr::null_mut();\n        unsafe { dladdr1(address, &mut info, &mut extra, RTLD_DL_LINKMAP) };\n        let link = (address as usize).wrapping_sub(info.dli_fbase as usize);"}]},
  {name: "lines_unvalidated", program: "test/probe", expect: "timestamp_malformed:", edits: [{file: "sdk/nu/jab.nu", find: "    if not ($unwritten | is-empty) {", put: "    if false {"}]},
  {name: "fragment_refused", program: "test/probe", expect: "fragment_accepted:", edits: [{file: "sdk/nu/jab.nu", find: "    let whole = ($text | split row (char nl) | drop 1)", put: "    let whole = (if ($text | str ends-with (char nl)) { $text | split row (char nl) | drop 1 } else { $text | split row (char nl) })"}]},
  {name: "metadata_apart", program: "test/probe", expect: "object_mixed:", edits: [{file: "sdk/nu/jab.nu", find: "    + 'object [0-9]+ (?:[0-9]+ [0-9]+ -?[0-9]+|- - -) .*'", put: "    + 'object [0-9]+ (?:[0-9]+|-) (?:[0-9]+|-) (?:-?[0-9]+|-) .*'"}]},
  {name: "notices_unrecognized", program: "test/probe", expect: "stopped_libsdl:", edits: [{file: "sdk/nu/jab.nu", find: "    + '|libSDL2 not found|symbol not found'\n", put: ""}]},
  {name: "stop_accepted", program: "test/probe", expect: "stopped_libsdl:", edits: [{file: "sdk/nu/jab.nu", find: "    if not ($notices | is-empty) {", put: "    if false {"}]}
]
