[
  {name: "sections_unguarded", program: "test/demand", expect: "legacy_reserved: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($sections | is-empty) {", put: "if false {"}]},
  {name: "empty_held", program: "test/demand", expect: "empty: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($specs | is-empty) {", put: "if false {"}]},
  {name: "list_unchecked", program: "test/demand", expect: "not_list: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($specs | describe | str starts-with \"list\") {", put: "if false {"}]},
  {name: "names_unchecked", program: "test/demand", expect: "not_name: refused", edits: [{file: "sdk/nu/jab.nu", find: "let unnamed = ($specs | where {|s| ($s | describe) != \"string\" or ($s | str trim) == \"\" })", put: "let unnamed = []"}]},
  {name: "blank_held", program: "test/demand", expect: "blank: refused", edits: [{file: "sdk/nu/jab.nu", find: "or ($s | str trim) == \"\" })", put: "or false })"}]},
  {name: "unknown_held", program: "test/demand", expect: "undefined: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($unknown | is-empty) { error make {msg: $\"($name):", put: "if false { error make {msg: $\"($name):"}]},
  {name: "case_sensitive", program: "test/demand", expect: "twice: refused", edits: [{file: "sdk/nu/jab.nu", find: "($r.name | str trim | str lowercase) == ($s | str trim | str lowercase)", put: "($r.name | str trim) == ($s | str trim)"}]},
  {name: "twice_held", program: "test/demand", expect: "twice: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($twice | is-empty) { error make {msg: $\"($name): `specs` names", put: "if false { error make {msg: $\"($name): `specs` names"}]},
  {name: "cores_unchecked", program: "test/demand", expect: "coreless: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($uncounted | is-empty) {", put: "if false {"}]},
  {name: "role_unchecked", program: "test/demand", expect: "reserved_role: refused", edits: [{file: "sdk/nu/jab.nu", find: "if $k not-in $roles {", put: "if false {"}]},
  {name: "count_unchecked", program: "test/demand", expect: "reserved_zero: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($n | describe) != \"int\" or $n < 1 {", put: "if false {"}]},
  {name: "zero_allowed", program: "test/demand", expect: "reserved_zero: refused", edits: [{file: "sdk/nu/jab.nu", find: "or $n < 1 {", put: "or $n < 0 {"}]},
  {name: "fraction_allowed", program: "test/demand", expect: "reserved_fraction: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($n | describe) != \"int\" or", put: "if ($n | describe) not-in [\"int\" \"float\"] or"}]},
  {name: "section_untyped", program: "test/demand", expect: "reserved_value: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($value | describe | str starts-with \"record\") {", put: "if false {"}]},
  {name: "feature_untyped", program: "test/demand", expect: "feature_value: refused", edits: [{file: "sdk/nu/jab.nu", find: "if $feature != null and not ($feature | describe | str starts-with \"record\") {", put: "if false {"}]},
  {name: "feature_name_unchecked", program: "test/demand", expect: "feature_name: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($f.feature =~ '^[a-z][a-z0-9_]*$') {", put: "if false {"}]},
  {name: "feature_empty_held", program: "test/demand", expect: "feature_none: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($counts | is-empty) {", put: "if false {"}]},
  {name: "features_dropped", program: "test/demand", expect: "a base demand equal to the spec's harts holds", edits: [{file: "sdk/nu/jab.nu", find: "$features = ($features | append ({ name: $f.feature } | merge $counts))", put: "$features = $features"}]},
  {name: "reservation_dropped", program: "test/demand", expect: "base_past: refused", edits: [{file: "sdk/nu/jab.nu", find: "insert $r ($held | get -o $r | default 0)", put: "insert $r 0"}]},
  {name: "base_main_only", program: "test/demand", expect: "base_past: refused", edits: [{file: "sdk/nu/jab.nu", find: "let base = (1 + $reserving)", put: "let base = $reserving"}]},
  {name: "base_short_held", program: "test/demand", expect: "base_past: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($short | is-empty) {", put: "if false {"}]},
  {name: "base_boundary", program: "test/demand", expect: "a base demand equal to the spec's harts holds", edits: [{file: "sdk/nu/jab.nu", find: "where {|p| $p.row.cores < $base }", put: "where {|p| $p.row.cores <= $base }"}]},
  {name: "plan_demand_dropped", program: "test/demand", expect: "on the specification's three harts a declared program's run is declared and not diagnostic", edits: [{file: "sdk/nu/jab.nu", find: "let demand = (image-demand $image)", put: "let demand = null"}]},
  {name: "declared_always", program: "test/demand", expect: "a legacy program's run is undeclared and diagnostic", edits: [{file: "sdk/nu/jab.nu", find: "declared: ($machine.demand != null),", put: "declared: true,"}]},
  {name: "diagnostic_machine_only", program: "test/demand", expect: "a legacy program's run is undeclared and diagnostic", edits: [{file: "sdk/nu/jab.nu", find: "diagnostic: ($ran_on.diagnostic or $machine.demand == null),", put: "diagnostic: $ran_on.diagnostic,"}]},
  {name: "diagnostic_demand_only", program: "test/demand", expect: "on four harts a declared program's run is declared and diagnostic", edits: [{file: "sdk/nu/jab.nu", find: "diagnostic: ($ran_on.diagnostic or $machine.demand == null),", put: "diagnostic: ($machine.demand == null),"}]},
  {name: "no_include_dir", program: "test/demand", expect: "the declared fixture builds afresh against its generated constants", edits: [{file: "sdk/nu/jab.nu", find: "let generated = (if $demand == null { [] } else { [$c.out] })", put: "let generated = []"}]},
  {name: "include_everywhere", program: "test/demand", expect: "the legacy build carries no generated constants' directory", edits: [{file: "sdk/nu/jab.nu", find: "let generated = (if $demand == null { [] } else { [$c.out] })", put: "let generated = [$c.out]"}]},
  {name: "retire_skipped", program: "test/demand", expect: "a build with the declaration dropped retires its constants and includes none", edits: [{file: "sdk/nu/jab.nu", find: "if $demand == null { retire ($c.out | path join \"jab_manifest.inc\") $c.root }", put: "if $demand == null { }"}]},
  {name: "no_demand_include", program: "test/demand", expect: "the declared fixture builds afresh against its generated constants", edits: [{file: "sdk/nu/jab.nu", find: "let constants = (if $demand == null { [] } else { [(demand-include $demand $c.out)] })", put: "let constants = []"}]},
  {name: "reserved_constant_zero", program: "test/demand", expect: "the declared fixture's constants, generated afresh", edits: [{file: "sdk/nu/jab.nu", find: "$\".set JAB_RESERVED_($r.role | str uppercase), ($r.harts)\"", put: "$\".set JAB_RESERVED_($r.role | str uppercase), 0\""}]},
  {name: "feature_constants_dropped", program: "test/demand", expect: "the declared fixture builds afresh against its generated constants", edits: [{file: "sdk/nu/jab.nu", find: "let features = ($d.features | each", put: "let features = ([] | each"}]},
  {name: "base_constant_wrong", program: "test/demand", expect: "the declared fixture's constants, generated afresh", edits: [{file: "sdk/nu/jab.nu", find: "$\".set JAB_BASE_HARTS, ($d.base)\"", put: "$\".set JAB_BASE_HARTS, 1\""}]},
  {name: "build_unchecked", program: "test/demand", expect: "the tool's build refuses a base demand past a listed spec", edits: [{file: "sdk/nu/jab.nu", find: "let demand = (program-demand $m $c.workspace)", put: "let demand = (if false { program-demand $m $c.workspace })"}]},
  {name: "record_unwritten", program: "test/demand", expect: "the build records its demand beside its image", edits: [{file: "sdk/nu/jab.nu", find: "{ image: (open --raw $image | hash sha256), demand: $demand } | to nuon | save -f (demand-record-of $image)", put: "null | ignore"}]},
  {name: "record_demand_null", program: "test/demand", expect: "the build records its demand beside its image", edits: [{file: "sdk/nu/jab.nu", find: "{ image: (open --raw $image | hash sha256), demand: $demand }", put: "{ image: (open --raw $image | hash sha256), demand: null }"}]},
  {name: "record_hash_elf", program: "test/demand", expect: "the build records its demand beside its image", edits: [{file: "sdk/nu/jab.nu", find: "{ image: (open --raw $image | hash sha256), demand: $demand }", put: "{ image: (open --raw $elf | hash sha256), demand: $demand }"}]},
  {name: "record_renamed", program: "test/demand", expect: "the build records its demand beside its image", edits: [{file: "sdk/nu/jab.nu", find: "path join \"demand.nuon\"", put: "path join \"record.nuon\""}]},
  {name: "cache_record_unheld", program: "test/demand", expect: "a build beside a record of another demand builds again", edits: [{file: "sdk/nu/jab.nu", find: "if (not (stale $image $inputs $id $stamp)) and (record-holds $image $demand) { return }", put: "if (not (stale $image $inputs $id $stamp)) { return }"}]},
  {name: "holds_unreadable", program: "test/demand", expect: "a build beside an unreadable record builds again", edits: [{file: "sdk/nu/jab.nu", find: "try { (image-demand $image) == $demand } catch { false }", put: "try { (image-demand $image) == $demand } catch { true }"}]},
  {name: "holds_any_demand", program: "test/demand", expect: "a build beside a record of another demand builds again", edits: [{file: "sdk/nu/jab.nu", find: "try { (image-demand $image) == $demand } catch { false }", put: "try { (image-demand $image) | ignore; true } catch { false }"}]},
  {name: "holds_never", program: "test/demand", expect: "a build beside a record that holds takes its cached image", edits: [{file: "sdk/nu/jab.nu", find: "try { (image-demand $image) == $demand } catch { false }", put: "false"}]},
  {name: "legacy_missing_held", program: "test/demand", expect: "a legacy build with its record retired builds again", edits: [{file: "sdk/nu/jab.nu", find: "if not (demand-record-of $image | path exists) { return false }", put: "if false { return false }"}]},
  {name: "plan_reads_manifest", program: "test/demand", expect: "a reservation edited without a rebuild leaves the plan the built demand", edits: [{file: "sdk/nu/jab.nu", find: "let demand = (image-demand $image)", put: "let demand = (if (image-manifest $image | is-empty) { null } else { program-demand (image-manifest $image) $ws })"}]},
  {name: "plan_swallows", program: "test/demand", expect: "a launch of an image altered after its build is refused", edits: [{file: "sdk/nu/jab.nu", find: "let demand = (image-demand $image)", put: "let demand = (try { image-demand $image } catch { null })"}]},
  {name: "absent_declared", program: "test/demand", expect: "with its record retired, a run of the declared image is undeclared and diagnostic", edits: [{file: "sdk/nu/jab.nu", find: "let file = (demand-record-of $image)\n    if not ($file | path exists) { return null }", put: "let file = (demand-record-of $image)\n    if not ($file | path exists) { return {} }"}]},
  {name: "lone_unchecked", program: "test/demand", expect: "a record beside no image is refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($image | path exists) { error make {msg: $\"($file) is the record of an image", put: "if false { error make {msg: $\"($file) is the record of an image"}]},
  {name: "nuon_unread", program: "test/demand", expect: "unreadable: refused", edits: [{file: "sdk/nu/jab.nu", find: "catch {|e| error make {msg: $\"($file): not NUON the tools can read: ($e.msg)\"} })", put: "catch { null })"}]},
  {name: "record_kind_unchecked", program: "test/demand", expect: "not_record: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($got | str starts-with \"record\") { return [$\"a record of", put: "if false { return [$\"a record of"}]},
  {name: "record_missing_unlisted", program: "test/demand", expect: "no_image: refused", edits: [{file: "sdk/nu/jab.nu", find: "$missing ++ $others ++ $image ++ $demand", put: "$others ++ $image ++ $demand"}]},
  {name: "record_others_unlisted", program: "test/demand", expect: "third: refused", edits: [{file: "sdk/nu/jab.nu", find: "$missing ++ $others ++ $image ++ $demand", put: "$missing ++ $image ++ $demand"}]},
  {name: "image_type_unchecked", program: "test/demand", expect: "image_int: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($i | describe) != \"string\" {", put: "if false {"}]},
  {name: "image_hex_unchecked", program: "test/demand", expect: "image_capitals: refused", edits: [{file: "sdk/nu/jab.nu", find: "} else if not ($i =~ '^[0-9a-f]{64}$') {", put: "} else if false {"}]},
  {name: "image_hash_unchecked", program: "test/demand", expect: "other_image: refused", edits: [{file: "sdk/nu/jab.nu", find: "} else if $i != $hash {", put: "} else if false {"}]},
  {name: "null_refused", program: "test/demand", expect: "a legacy image's record reads as no demand", edits: [{file: "sdk/nu/jab.nu", find: "if $d == null { return [] }", put: "if $d == null { return [\"demand: null\"] }"}]},
  {name: "demand_kind_unchecked", program: "test/demand", expect: "demand_text: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($got | str starts-with \"record\") { return [$\"demand: a record or null expected", put: "if false { return [$\"demand: a record or null expected"}]},
  {name: "demand_missing_unlisted", program: "test/demand", expect: "demand_missing: refused", edits: [{file: "sdk/nu/jab.nu", find: "$missing ++ $others ++ $specs ++ $reserved ++ $features ++ $base", put: "$others ++ $specs ++ $reserved ++ $features ++ $base"}]},
  {name: "demand_others_unlisted", program: "test/demand", expect: "demand_field: refused", edits: [{file: "sdk/nu/jab.nu", find: "$missing ++ $others ++ $specs ++ $reserved ++ $features ++ $base", put: "$missing ++ $specs ++ $reserved ++ $features ++ $base"}]},
  {name: "specs_kind_unchecked", program: "test/demand", expect: "specs_text: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($kind | str starts-with \"list\") { [$\"demand.specs: a list of names expected", put: "if false { [$\"demand.specs: a list of names expected"}]},
  {name: "specs_empty_held", program: "test/demand", expect: "specs_none: refused", edits: [{file: "sdk/nu/jab.nu", find: "} else if ($s | is-empty) { [\"demand.specs: empty\"] } else {", put: "} else if false { [\"demand.specs: empty\"] } else {"}]},
  {name: "specs_names_unchecked", program: "test/demand", expect: "specs_unnamed: refused", edits: [{file: "sdk/nu/jab.nu", find: "$s | enumerate | where {|e| ($e.item | describe) != \"string\" or ($e.item | str trim) == \"\" }", put: "$s | enumerate | where {|e| false }"}]},
  {name: "reserved_kind_unchecked", program: "test/demand", expect: "reserved_kind: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($r | describe | str starts-with \"record\") { [$\"demand.reserved: a record expected", put: "if false { [$\"demand.reserved: a record expected"}]},
  {name: "reserved_absent_unlisted", program: "test/demand", expect: "reserved_missing: refused", edits: [{file: "sdk/nu/jab.nu", find: "$absent ++ $foreign ++ $counts", put: "$foreign ++ $counts"}]},
  {name: "reserved_foreign_unlisted", program: "test/demand", expect: "reserved_foreign: refused", edits: [{file: "sdk/nu/jab.nu", find: "$absent ++ $foreign ++ $counts", put: "$absent ++ $counts"}]},
  {name: "reserved_counts_unlisted", program: "test/demand", expect: "reserved_negative: refused", edits: [{file: "sdk/nu/jab.nu", find: "$absent ++ $foreign ++ $counts", put: "$absent ++ $foreign"}]},
  {name: "features_kind_unchecked", program: "test/demand", expect: "features_value: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not (($kind | str starts-with \"list\") or ($kind | str starts-with \"table\")) {", put: "if false {"}]},
  {name: "feature_kind_unchecked", program: "test/demand", expect: "feature_kind: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($f | describe | str starts-with \"record\") {", put: "if false {"}]},
  {name: "feature_name_unrequired", program: "test/demand", expect: "feature_unnamed: refused", edits: [{file: "sdk/nu/jab.nu", find: "let named = (if \"name\" not-in $keys {", put: "let named = (if false {"}]},
  {name: "feature_name_uncased", program: "test/demand", expect: "feature_capitals: refused", edits: [{file: "sdk/nu/jab.nu", find: "($f.name | describe) != \"string\" or not ($f.name =~ '^[a-z][a-z0-9_]*$')", put: "($f.name | describe) != \"string\""}]},
  {name: "feature_foreign_unlisted", program: "test/demand", expect: "feature_foreign: refused", edits: [{file: "sdk/nu/jab.nu", find: "$named ++ $foreign ++ $none ++ $counts", put: "$named ++ $none ++ $counts"}]},
  {name: "feature_idle_unlisted", program: "test/demand", expect: "feature_idle: refused", edits: [{file: "sdk/nu/jab.nu", find: "$named ++ $foreign ++ $none ++ $counts", put: "$named ++ $foreign ++ $counts"}]},
  {name: "feature_counts_unlisted", program: "test/demand", expect: "feature_count: refused", edits: [{file: "sdk/nu/jab.nu", find: "$named ++ $foreign ++ $none ++ $counts", put: "$named ++ $foreign ++ $none"}]},
  {name: "base_kind_unchecked", program: "test/demand", expect: "base_text: refused", edits: [{file: "sdk/nu/jab.nu", find: "if ($b | describe) != \"int\" {", put: "if false {"}]},
  {name: "base_sum_unchecked", program: "test/demand", expect: "base_off: refused", edits: [{file: "sdk/nu/jab.nu", find: "} else if $summed != null and $b != $summed {", put: "} else if false {"}]},
  {name: "shape_unchecked", program: "test/demand", expect: "demand_text: refused", edits: [{file: "sdk/nu/jab.nu", find: "let demand = (if \"demand\" not-in $fields { [] } else { demand-shape-problems $record.demand })", put: "let demand = []"}]},
  {name: "problems_ignored", program: "test/demand", expect: "not_record: refused", edits: [{file: "sdk/nu/jab.nu", find: "if not ($problems | is-empty) { error make", put: "if false { error make"}]},
  {name: "include_not_input", program: "test/demand", expect: "a build beside an include its generator no longer writes builds again", edits: [{file: "sdk/nu/jab.nu", find: "++ [$c.manifest_path $m.link] ++ $specs ++ $constants)", put: "++ [$c.manifest_path $m.link] ++ $specs)"}]},
  {name: "include_after_check", program: "test/demand", expect: "a build beside an include its generator no longer writes builds again", edits: [{file: "sdk/nu/jab.nu", find: "let constants = (if $demand == null { [] } else { [(demand-include $demand $c.out)] })", put: "let constants = (if $demand == null { [] } else { [($c.out | path join \"jab_manifest.inc\")] })"}, {file: "sdk/nu/jab.nu", find: "if $demand == null { retire ($c.out | path join \"jab_manifest.inc\") $c.root }", put: "if $demand == null { retire ($c.out | path join \"jab_manifest.inc\") $c.root } else { demand-include $demand $c.out | ignore }"}]},
  {name: "include_always_written", program: "test/demand", expect: "a build beside a record that holds takes its cached image", edits: [{file: "sdk/nu/jab.nu", find: "if $held != $text { $text | save -f $file }", put: "$text | save -f $file"}]}
]
